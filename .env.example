# Supabase — proyecto "dentalkab"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Prisma — conexión a Postgres de Supabase.
# DATABASE_URL: pooled (pgbouncer, puerto 6543) — usada en runtime por la app.
# DIRECT_URL: directa (puerto 5432) — usada solo por el CLI de Prisma (migrate).
# La contraseña debe ir URL-encoded si tiene caracteres especiales (p. ej. "/" -> "%2F").
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
